# ─── Database ───────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agricsec"

# ─── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ─── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Email (Nodemailer) ──────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@agricsec.com

# ─── File Upload ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Weather API (Open-Meteo — free, no key needed) ─────────────
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# ─── Market Price API ────────────────────────────────────────────
# Example: FAO GIEWS or custom scrape endpoint
MARKET_API_URL=https://your-market-data-endpoint.com
MARKET_API_KEY=your_market_api_key

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=info
